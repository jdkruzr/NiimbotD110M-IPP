+/** One active physical job per process. Fail closed on uncertain completion. */
+let active = false;
+export async function runBoundedJob<T>(milliseconds: number, work: (signal: AbortSignal) => Promise<T>, disconnect: () => Promise<void>): Promise<T> {
+  if (active) throw new Error('A print job is already active');
+  if (!Number.isFinite(milliseconds) || milliseconds <= 0) throw new Error('Invalid job deadline');
+  active = true;
+  const controller = new AbortController();
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const cancel = () => controller.abort(new Error('Print cancelled; physical completion UNKNOWN; do not automatically retry'));
+  process.once('SIGINT', cancel);
+  process.once('SIGTERM', cancel);
+  const cancelled = new Promise<never>((_, reject) => {
+    controller.signal.addEventListener('abort', () => reject(controller.signal.reason), {once: true});
+    timer = setTimeout(() => controller.abort(new Error('Print deadline exceeded; physical completion UNKNOWN; do not automatically retry')), milliseconds);
+  });
+  const operation = Promise.resolve().then(() => work(controller.signal));
+  try {
+    return await Promise.race([operation, cancelled]);
+  } catch (error) {
+    controller.abort(error);
+    await disconnect().catch(() => undefined);
+    throw error;
+  } finally {
+    clearTimeout(timer);
+    process.removeListener('SIGINT', cancel);
+    process.removeListener('SIGTERM', cancel);
+    // Keep the process locked until any in-flight work has actually settled.
+    void operation.finally(() => { active = false; }).catch(() => undefined);
+  }
+}
+
+export async function pollPages(signal: AbortSignal, pages: number, read: () => Promise<{page: number}>, interval = 500): Promise<void> {
+  while (true) {
+    signal.throwIfAborted();
+    const status = await read();
+    signal.throwIfAborted();
+    if (status.page >= pages) return;
+    await new Promise<void>((resolve, reject) => {
+      const abort = () => { clearTimeout(timer); reject(signal.reason); };
+      const timer = setTimeout(() => { signal.removeEventListener('abort', abort); resolve(); }, interval);
+      signal.addEventListener('abort', abort, {once: true});
+      if (signal.aborted) abort();
+    });
+  }
+}
